    for pair in date_fixtures:
        var text = pair[0]
        var expected_days = pair[1]
        var days = decode_date(text)
        assert_equal(
            Int64(days), expected_days, String("decode_date(", text, ")")
        )
        var re_encoded = encode_date(days)
        assert_equal(
            re_encoded, text, String("encode_date round trip for ", text)
        )


# ===----------------------------------------------------------------------===#
# time
# ===----------------------------------------------------------------------===#


def test_decode_time() raises:
    assert_equal(decode_time("00:00:00"), Int64(0))
    assert_equal(decode_time("00:00:00.000000"), Int64(0))
    assert_equal(decode_time("23:59:59.999999"), Int64(86399999999))
    assert_equal(decode_time("12:00:00.5"), Int64(43200500000))
    assert_equal(decode_time("01:02:03"), Int64(3723000000))


def test_decode_time_errors() raises:
    with assert_raises():
        _ = decode_time("")
    with assert_raises():
        _ = decode_time("24:00:00")
    with assert_raises():
        _ = decode_time("00:60:00")
    with assert_raises():
        _ = decode_time("00:00:60")
    with assert_raises():
        _ = decode_time("00:00")
    with assert_raises():
        _ = decode_time("00:00:00.1234567")


def test_encode_time() raises:
    assert_equal(encode_time(Int64(0)), "00:00:00.000000")
    assert_equal(encode_time(Int64(86399999999)), "23:59:59.999999")
    assert_equal(encode_time(Int64(3723000000)), "01:02:03.000000")


def test_time_round_trip() raises:
    var cases: List[String] = [
        "00:00:00.000000",
        "23:59:59.999999",
        "12:34:56.000001",
        "01:02:03.000000",
    ]
    for text in cases:
        var micros = decode_time(text)
        assert_equal(encode_time(micros), text)


# ===----------------------------------------------------------------------===#
# timestamp (naive)
# ===----------------------------------------------------------------------===#


def test_decode_timestamp_basic() raises:
    assert_equal(decode_timestamp("1970-01-01 00:00:00"), Int64(0))
    assert_equal(decode_timestamp("1969-12-31 23:59:59.999999"), Int64(-1))
    assert_equal(decode_timestamp("1969-12-31 00:00:00"), Int64(-86400000000))


def test_decode_timestamp_errors() raises:
    with assert_raises(contains="infinite"):
        _ = decode_timestamp("infinity")
    with assert_raises(contains="BC"):
        _ = decode_timestamp("0044-01-01 00:00:00 BC")
    with assert_raises():
        _ = decode_timestamp("1970-01-01T00:00:00")
    with assert_raises():
        _ = decode_timestamp("")


def test_encode_timestamp() raises:
    assert_equal(encode_timestamp(Int64(0)), "1970-01-01 00:00:00.000000")
    assert_equal(encode_timestamp(Int64(-1)), "1969-12-31 23:59:59.999999")
    assert_equal(
        encode_timestamp(Int64(-86400000000)), "1969-12-31 00:00:00.000000"
    )


def test_timestamp_sweep_round_trip() raises:
    var timestamp_fixtures: List[Tuple[String, Int64]] = [
        ("1970-01-01 00:00:00.000000", Int64(0)),
        ("1969-12-31 23:59:59.999999", Int64(-1)),
        ("1969-12-31 00:00:00.000000", Int64(-86400000000)),
        ("2000-01-01 00:00:00.000000", Int64(946684800000000)),
        ("2000-02-29 12:30:45.123456", Int64(951827445123456)),
        ("2038-01-19 03:14:08.000000", Int64(2147483648000000)),
        ("0001-01-01 00:00:00.000000", Int64(-62135596800000000)),
        ("9999-12-31 23:59:59.999999", Int64(253402300799999999)),
        ("1900-03-01 06:00:00.500000", Int64(-2203869599500000)),
        ("2024-02-29 18:45:00.000001", Int64(1709232300000001)),
    ]
    for pair in timestamp_fixtures:
        var text = pair[0]
        var expected_micros = pair[1]
        var micros = decode_timestamp(text)
        assert_equal(
            micros, expected_micros, String("decode_timestamp(", text, ")")
        )
        var re_encoded = encode_timestamp(micros)
        assert_equal(
            re_encoded,
            text,
            String("encode_timestamp round trip for ", text),
        )


# ===----------------------------------------------------------------------===#
# timestamptz
# ===----------------------------------------------------------------------===#


def test_decode_timestamptz_basic() raises:
    assert_equal(decode_timestamptz("1970-01-01 00:00:00+00"), Int64(0))
    assert_equal(
        decode_timestamptz("1970-01-01 00:00:00-05"),
        Int64(5 * 3600 * 1_000_000),
    )
    assert_equal(decode_timestamptz("1970-01-01 05:30:00+05:30"), Int64(0))
    assert_equal(decode_timestamptz("1970-01-01 01:00:00+01:00"), Int64(0))


def test_decode_timestamptz_errors() raises:
    with assert_raises(contains="infinite"):
        _ = decode_timestamptz("infinity")
    with assert_raises():
        _ = decode_timestamptz("1970-01-01 00:00:00")  # missing offset
    with assert_raises():
        _ = decode_timestamptz("")


def test_encode_timestamptz() raises:
    assert_equal(encode_timestamptz(Int64(0)), "1970-01-01 00:00:00.000000+00")


def test_timestamptz_sweep() raises:
    var timestamptz_fixtures: List[Tuple[String, Int64]] = [
        ("1970-01-01 00:00:00.000000+00", Int64(0)),
        ("2000-01-01 00:00:00.000000-05", Int64(946702800000000)),
        ("2000-01-01 00:00:00.000000+05:30", Int64(946665000000000)),
        ("2024-06-15 12:00:00.250000+01:00", Int64(1718449200250000)),
        ("1969-12-31 23:00:00.000000-05", Int64(14400000000)),
        ("2038-01-19 03:14:07.000000+00", Int64(2147483647000000)),
        ("1900-03-01 06:00:00.000000+05:30", Int64(-2203889400000000)),
        ("9999-12-31 23:59:59.999999+00", Int64(253402300799999999)),
        ("0001-01-01 00:00:00.000000-05", Int64(-62135578800000000)),
        ("2000-02-29 12:00:00.000000+01:00", Int64(951822000000000)),
    ]
    for pair in timestamptz_fixtures:
        var text = pair[0]
        var expected_micros = pair[1]
        var micros = decode_timestamptz(text)
        assert_equal(
            micros,
            expected_micros,
            String("decode_timestamptz(", text, ")"),
        )
        # encode_timestamptz always emits a `+00` offset (UTC carries no
        # original offset), so re-decoding the re-encoded text must land on
        # the same instant even when it does not match the original text.
        var re_encoded = encode_timestamptz(micros)
        var re_decoded = decode_timestamptz(re_encoded)
        assert_equal(
            re_decoded,
            expected_micros,
            String("round trip through re-encoding ", text),
        )


# ===----------------------------------------------------------------------===#
# text / OID helpers
# ===----------------------------------------------------------------------===#


def test_decode_text() raises:
    assert_equal(decode_text("hello world"), "hello world")
    assert_equal(decode_text(""), "")


def test_is_infinite() raises:
    assert_true(is_infinite("infinity"))
    assert_true(is_infinite("-infinity"))
    assert_true(not is_infinite("2000-01-01"))
    assert_true(not is_infinite(""))


def test_is_text_oid() raises:
    assert_true(is_text_oid(OID_TEXT))
    assert_true(is_text_oid(OID_VARCHAR))
    assert_true(is_text_oid(OID_BPCHAR))
    assert_true(is_text_oid(OID_UUID))
    assert_true(is_text_oid(OID_JSON))
    assert_true(is_text_oid(OID_JSONB))
    assert_true(is_text_oid(OID_NUMERIC))
    assert_true(not is_text_oid(OID_INT4))
    assert_true(not is_text_oid(OID_BOOL))
    assert_true(not is_text_oid(OID_TIMESTAMPTZ))


def test_oid_name() raises:
    assert_equal(oid_name(OID_BOOL), "bool")
    assert_equal(oid_name(OID_INT8), "int8")
    assert_equal(oid_name(OID_INT2), "int2")
    assert_equal(oid_name(OID_INT4), "int4")
    assert_equal(oid_name(OID_TEXT), "text")
    assert_equal(oid_name(OID_FLOAT4), "float4")
    assert_equal(oid_name(OID_FLOAT8), "float8")
    assert_equal(oid_name(OID_BYTEA), "bytea")
    assert_equal(oid_name(OID_DATE), "date")
    assert_equal(oid_name(OID_TIME), "time")
    assert_equal(oid_name(OID_TIMESTAMP), "timestamp")
    assert_equal(oid_name(OID_TIMESTAMPTZ), "timestamptz")
    assert_equal(oid_name(OID_NUMERIC), "numeric")
    assert_equal(oid_name(OID_UUID), "uuid")
    assert_equal(oid_name(OID_JSON), "json")
    assert_equal(oid_name(OID_JSONB), "jsonb")
    assert_equal(oid_name(UInt32(999999)), "oid:999999")


def main() raises:
    TestSuite.discover_tests[__functions_in_module()]().run()
