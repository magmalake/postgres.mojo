"""Tests for `postgres.text` — every decoder/encoder, NULL-adjacent edge
cases, both `bytea` sub-formats, and generated date/timestamp sweeps.

The date and timestamp/timestamptz fixture lists below are generated by
`tests/gen_text_fixtures.py` (`pixi run -e default python
tests/gen_text_fixtures.py`) and pasted in verbatim — re-run the generator
and re-paste to extend coverage; the Python source is checked in beside this
file so the fixtures are reproducible.
"""

from std.testing import TestSuite, assert_equal, assert_true, assert_raises
from std.utils.numerics import isnan, isinf

from postgres.text import (
    OID_BOOL,
    OID_BYTEA,
    OID_DATE,
    OID_FLOAT4,
    OID_FLOAT8,
    OID_INT2,
    OID_INT4,
    OID_INT8,
    OID_JSON,
    OID_JSONB,
    OID_NUMERIC,
    OID_TEXT,
    OID_TIME,
    OID_TIMESTAMP,
    OID_TIMESTAMPTZ,
    OID_UUID,
    OID_VARCHAR,
    OID_BPCHAR,
    decode_bool,
    decode_bytea,
    decode_date,
    decode_float32,
    decode_float64,
    decode_int16,
    decode_int32,
    decode_int64,
    decode_text,
    decode_time,
    decode_timestamp,
    decode_timestamptz,
    encode_bool,
    encode_bytea,
    encode_date,
    encode_float32,
    encode_float64,
    encode_int16,
    encode_int32,
    encode_int64,
    encode_time,
    encode_timestamp,
    encode_timestamptz,
    is_infinite,
    is_text_oid,
    oid_name,
)


# ===----------------------------------------------------------------------===#
# bool
# ===----------------------------------------------------------------------===#


def test_decode_bool() raises:
    assert_equal(decode_bool("t"), True)
    assert_equal(decode_bool("f"), False)
    assert_equal(decode_bool("true"), True)
    assert_equal(decode_bool("false"), False)
    with assert_raises(contains="bool"):
        _ = decode_bool("")
    with assert_raises(contains="bool"):
        _ = decode_bool("yes")
    with assert_raises(contains="bool"):
        _ = decode_bool("T")


def test_encode_bool() raises:
    assert_equal(encode_bool(True), "t")
    assert_equal(encode_bool(False), "f")


# ===----------------------------------------------------------------------===#
# Integers
# ===----------------------------------------------------------------------===#


def test_decode_int16() raises:
    assert_equal(decode_int16("0"), Int16(0))
    assert_equal(decode_int16("32767"), Int16(32767))
    assert_equal(decode_int16("-32768"), Int16(-32768))
    assert_equal(decode_int16("+7"), Int16(7))
    assert_equal(decode_int16("-0"), Int16(0))
    with assert_raises(contains="int2"):
        _ = decode_int16("32768")
    with assert_raises(contains="int2"):
        _ = decode_int16("-32769")
    with assert_raises(contains="int2"):
        _ = decode_int16("")
    with assert_raises(contains="int2"):
        _ = decode_int16(" 1")
    with assert_raises(contains="int2"):
        _ = decode_int16("1 ")
    with assert_raises(contains="int2"):
        _ = decode_int16("1.0")
    with assert_raises(contains="int2"):
        _ = decode_int16("-")
    with assert_raises(contains="int2"):
        _ = decode_int16("+")


def test_decode_int32() raises:
    assert_equal(decode_int32("2147483647"), Int32(2147483647))
    assert_equal(decode_int32("-2147483648"), Int32(-2147483648))
    with assert_raises(contains="int4"):
        _ = decode_int32("2147483648")
    with assert_raises(contains="int4"):
        _ = decode_int32("-2147483649")
    with assert_raises(contains="int4"):
        _ = decode_int32("")


def test_decode_int64() raises:
    assert_equal(
        decode_int64("9223372036854775807"), Int64(9223372036854775807)
    )
    assert_equal(
        decode_int64("-9223372036854775808"), Int64(-9223372036854775808)
    )
    with assert_raises(contains="int8"):
        _ = decode_int64("9223372036854775808")
    with assert_raises(contains="int8"):
        _ = decode_int64("-9223372036854775809")
    with assert_raises(contains="int8"):
        _ = decode_int64("99999999999999999999999999")
    with assert_raises(contains="int8"):
        _ = decode_int64("")


def test_encode_int() raises:
    assert_equal(encode_int16(Int16(-5)), "-5")
    assert_equal(encode_int16(Int16(32767)), "32767")
    assert_equal(encode_int32(Int32(2147483647)), "2147483647")
    assert_equal(encode_int32(Int32(-2147483648)), "-2147483648")
    assert_equal(
        encode_int64(Int64(9223372036854775807)), "9223372036854775807"
    )
    assert_equal(
        encode_int64(Int64(-9223372036854775808)), "-9223372036854775808"
    )


# ===----------------------------------------------------------------------===#
# Floats
# ===----------------------------------------------------------------------===#


def test_decode_float64_finite() raises:
    assert_equal(decode_float64("3.5"), Float64(3.5))
    assert_equal(decode_float64("-2.5e10"), Float64(-2.5e10))
    assert_equal(decode_float64("0"), Float64(0.0))
    with assert_raises():
        _ = decode_float64("")
    with assert_raises():
        _ = decode_float64("not a float")


def test_decode_float64_nonfinite() raises:
    assert_true(isnan(decode_float64("NaN")))
    assert_true(isnan(decode_float64("nan")))
    assert_true(isnan(decode_float64("NAN")))
    assert_true(isinf(decode_float64("Infinity")))
    assert_true(decode_float64("Infinity") > 0)
    assert_true(isinf(decode_float64("-Infinity")))
    assert_true(decode_float64("-Infinity") < 0)
    assert_true(isinf(decode_float64("inf")))
    assert_true(isinf(decode_float64("-inf")))
    assert_true(isinf(decode_float64("INFINITY")))


def test_decode_float32() raises:
    assert_equal(decode_float32("3.5"), Float32(3.5))
    assert_true(isnan(decode_float32("NaN")))
    assert_true(isinf(decode_float32("-Infinity")))
    with assert_raises():
        _ = decode_float32("")


def test_encode_float64() raises:
    assert_equal(encode_float64(Float64(1.5)), "1.5")
    assert_equal(encode_float64(decode_float64("NaN")), "NaN")
    assert_equal(encode_float64(decode_float64("Infinity")), "Infinity")
    assert_equal(encode_float64(decode_float64("-Infinity")), "-Infinity")
    # round trip through decode
    assert_true(isnan(decode_float64(encode_float64(decode_float64("nan")))))


def test_encode_float32() raises:
    assert_equal(encode_float32(Float32(1.5)), "1.5")
    assert_equal(encode_float32(decode_float32("NaN")), "NaN")
    assert_equal(encode_float32(decode_float32("Infinity")), "Infinity")
    assert_equal(encode_float32(decode_float32("-Infinity")), "-Infinity")


# ===----------------------------------------------------------------------===#
# bytea
# ===----------------------------------------------------------------------===#


def test_decode_bytea_hex() raises:
    var empty = decode_bytea("\\x")
    assert_equal(len(empty), 0)

    var b = decode_bytea("\\x0aFF")
    assert_equal(len(b), 2)
    assert_equal(b[0], UInt8(0x0A))
    assert_equal(b[1], UInt8(0xFF))

    with assert_raises():
        _ = decode_bytea("\\x0")
    with assert_raises():
        _ = decode_bytea("\\xzz")


def test_decode_bytea_escape() raises:
    # 'a', literal backslash, 'b', byte 65 ('A') via \101 octal
    var b = decode_bytea("a\\\\b\\101")
    assert_equal(len(b), 4)
    assert_equal(b[0], UInt8(ord("a")))
    assert_equal(b[1], UInt8(0x5C))
    assert_equal(b[2], UInt8(ord("b")))
    assert_equal(b[3], UInt8(65))

    var plain = decode_bytea("hello")
    assert_equal(len(plain), 5)
    assert_equal(plain[4], UInt8(ord("o")))

    with assert_raises():
        _ = decode_bytea("\\4")
    with assert_raises():
        _ = decode_bytea("\\400")  # octal value > 255


def test_encode_bytea() raises:
    var data: List[UInt8] = [UInt8(0x0A), UInt8(0xFF), UInt8(0x00)]
    assert_equal(encode_bytea(data), "\\x0aff00")
    var empty = List[UInt8]()
    assert_equal(encode_bytea(empty), "\\x")


def test_bytea_round_trip() raises:
    var original: List[UInt8] = [UInt8(0), UInt8(1), UInt8(254), UInt8(255)]
    var text = encode_bytea(original)
    var decoded = decode_bytea(text)
    assert_equal(len(decoded), len(original))
    for i in range(len(original)):
        assert_equal(decoded[i], original[i])


# ===----------------------------------------------------------------------===#
# date
# ===----------------------------------------------------------------------===#


def test_decode_date_basic() raises:
    assert_equal(decode_date("1970-01-01"), Int32(0))
    assert_equal(decode_date("1969-12-31"), Int32(-1))
    assert_equal(decode_date("2000-02-29"), Int32(11016))
    assert_equal(decode_date("2038-01-19"), Int32(24855))


def test_decode_date_errors() raises:
    with assert_raises(contains="infinite"):
        _ = decode_date("infinity")
    with assert_raises(contains="infinite"):
        _ = decode_date("-infinity")
    with assert_raises(contains="BC"):
        _ = decode_date("0044-01-01 BC")
    with assert_raises():
        _ = decode_date("")
    with assert_raises():
        _ = decode_date("2000-13-01")
    with assert_raises():
        _ = decode_date("2000-01-32")
    with assert_raises():
        _ = decode_date("2000-01-01x")
    with assert_raises():
        _ = decode_date("2000/01/01")


def test_encode_date() raises:
    assert_equal(encode_date(Int32(0)), "1970-01-01")
    assert_equal(encode_date(Int32(-1)), "1969-12-31")
    assert_equal(encode_date(Int32(11016)), "2000-02-29")


